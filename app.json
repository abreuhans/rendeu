{
  "expo": {
    "name": "Rendeu",
    "slug": "rendeu",
    "scheme": "rendeu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D7A4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Rendeu",
      "shortName": "Rendeu",
      "lang": "pt-BR",
      "themeColor": "#1D7A4A",
      "backgroundColor": "#EEF3EC"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#1D7A4A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0D1511"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Rendeu usa a câmera para ler o QR Code da nota fiscal e atualizar os preços dos mercados.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
